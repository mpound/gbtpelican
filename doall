#!/bin/csh -f
# Reduce the data in an embarrassingly parallel way

foreach session (01 03 04)
    foreach line ("HCO+" "HCN")
         echo "Doing line=$line session=$session..."
        (./pelican.py --line $line --input input.tab --session $session  --flux >& $line.$session.log) &
    end
end
foreach session (05)
         line="CS"
         echo "Doing line=$line session=$session..."
        (./pelican.py --line $line --input input.tab --session $session  --flux >& $line.$session.log) &
end

